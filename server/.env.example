NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=1433
DB_NAME=portfolio_dev
DB_USER=portfolio_app
DB_PASSWORD=여기에_비밀번호_입력

# 암호화 설정. 비워두면 NODE_ENV 에 따라 자동으로 정해진다.
# (운영=암호화 켬 / 로컬=자체 서명 인증서라 검증 생략)
# 호스팅 환경이 달라 수동으로 맞춰야 할 때만 채운다.
#DB_ENCRYPT=true
#DB_TRUST_CERT=false

# 인증 토큰 서명 키. 아래 명령으로 만들어 채운다.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=여기에_랜덤한_긴_문자열_입력
JWT_EXPIRES_IN=2h
